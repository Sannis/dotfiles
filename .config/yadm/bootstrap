#!/bin/bash
set -e

REPO="$(yadm introspect repo)"

# Enable sparse checkout to keep root-level repo-only files (README.md, setup.sh, CLAUDE.md)
# out of the home directory. Patterns are anchored with / to avoid matching same-named files
# in subdirectories (e.g. .claude/CLAUDE.md must not be excluded).
yadm sparse-checkout init --no-cone
cat > "$REPO/info/sparse-checkout" <<'SPARSE'
/*
!/README.md
!/setup.sh
!/CLAUDE.md
SPARSE
yadm read-tree -mu HEAD
